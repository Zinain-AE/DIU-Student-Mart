{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "public/index.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "public/index.php"
    }
  ],
  "build": {
    "env": {
      "COMPOSER_LABELS": "0"
    }
  }
}
